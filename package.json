{
  "name": "generate-assets-for-dart",
  "displayName": "Generate Assets for Dart",
  "description": "Generate AppDrawables class with paths to asset files",
  "version": "0.0.1",
  "publisher": "twilight2dev",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:generate-assets.generateAssets"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [{
      "command": "generate-assets.generateAssets",
      "title": "Generate Assets"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "undici": "^7.0.0",
    "yaml": "^2.6.1"
  }
}